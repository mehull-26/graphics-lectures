{
  "$ref": "#/definitions/lectures",
  "definitions": {
    "lectures": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "lectureNumber": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "summary": {
          "type": "string",
          "default": ""
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "readings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "label",
              "href"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "label",
              "href"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "label",
              "href"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "lectureNumber"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}