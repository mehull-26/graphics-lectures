---
import { getCollection } from 'astro:content';
import SiteLayout from '../../components/SiteLayout.astro';

const seriesEntries = (await getCollection('series')).sort(
  (a, b) => a.data.order - b.data.order
);

const toSeriesSlug = (entryId: string) => entryId.split('/')[0];
const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path.replace(/^\/+/, '')}`;
---

<SiteLayout title="Series | Graphics Lectures">
  <main>
    <h1>Lecture Series</h1>
    <ul>
      {seriesEntries.map((entry) => {
        const slug = toSeriesSlug(entry.id);
        return (
          <li>
            <a href={withBase(`series/${slug}`)}>{entry.data.title}</a>
            <p>{entry.data.description}</p>
          </li>
        );
      })}
    </ul>
    <p><a href={withBase('')}>Back to archive</a></p>
  </main>
</SiteLayout>