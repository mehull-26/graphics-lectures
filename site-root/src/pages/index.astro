---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';

const seriesEntries = (await getCollection('series')).sort(
  (a, b) => a.data.order - b.data.order
);

const toSeriesSlug = (entryId: string) => entryId.split('/')[0];
const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path.replace(/^\/+/, '')}`;
---

<SiteLayout title="Graphics Lectures">
  <main class="home-main">
    <section class="home-intro">
      <h1 class="home-title">Graphics &amp; Simulation Notes</h1>

      <p class="home-lead">
        A structured set of lecture notes on rendering, physics, and simulation.
        This site is a long-term technical archive rather than a blog.
      </p>

      <p class="home-sublead">
        Each lecture focuses on building intuition first, then connecting physics,
        mathematics, and implementation. Over time this will expand into multiple
        series covering rendering, numerical methods, and simulation systems.
      </p>
    </section>

    <section>
      <h2 class="home-section-title">Lecture Series</h2>

      <div class="series-list">
        {seriesEntries.map((entry) => {
          const slug = toSeriesSlug(entry.id);
          return (
            <a
              href={withBase(`series/${slug}`)}
              class="series-card"
            >
              <div class="series-card-title">{entry.data.title}</div>

              {entry.data.description && (
                <div class="series-card-summary">
                  {entry.data.description}
                </div>
              )}
            </a>
          );
        })}
      </div>
    </section>
  </main>
</SiteLayout>
