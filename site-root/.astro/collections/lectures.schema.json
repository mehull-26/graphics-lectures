{
  "$ref": "#/definitions/lectures",
  "definitions": {
    "lectures": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "lectureNumber": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "summary": {
          "type": "string",
          "default": ""
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "starterRepo": {
          "type": "string",
          "format": "uri"
        },
        "finishedRepo": {
          "type": "string",
          "format": "uri"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "lectureNumber"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}