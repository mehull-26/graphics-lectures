hromeDevtoolsWorkspace\":false,\"failOnPrerenderConflict\":false,\"svgo\":false},\"legacy\":{\"collections\":false}}","series",["Map",11,12],"rendering/series",{"id":11,"data":13,"body":17,"filePath":18,"digest":19,"rendered":20},{"title":14,"description":15,"order":16},"Rendering","Physics-based rendering lectures with derivations, implementation notes, and practical GPU context.",1,"Rendering lecture series.","src/content/series/rendering/series.md","f4efacfc57a1f5a9",{"html":21,"metadata":22},"\u003Cp>Rendering lecture series.\u003C/p>",{"headings":23,"localImagePaths":24,"remoteImagePaths":25,"frontmatter":26,"imagePaths":27},[],[],[],{"title":14,"description":15,"order":16},[],"lectures",["Map",30,31],"rendering/lecture-01/lecture",{"id":30,"data":32,"body":38,"filePath":39,"digest":40,"deferredRender":41},{"title":33,"lectureNumber":16,"summary":34,"publishedAt":35,"starterRepo":36,"finishedRepo":37},"Radiometry Foundations","Core radiometric quantities and why they matter for physically based rendering.",["Date","2026-02-13T00:00:00.000Z"],"https://github.com/your-org/rendering-l01-starter","https://github.com/your-org/minimal-path-tracer","import radiometryDiagram from './assets/radiometry.png';\r\n\r\nThis lecture introduces radiometric quantities used in physically based rendering.\r\n\r\n---\r\n\r\n## What this lecture covers\r\n\r\n- Why radiometry is the right language for light transport.\r\n- The relationship between flux, irradiance, and radiance.\r\n- How these quantities appear in rendering equations.\r\n\r\n\u003Cdetails>\r\n\u003Csummary>Derivation\u003C/summary>\r\n\r\nStarting from flux $\\Phi$, irradiance over a differential area is:\r\n\r\n$E = d\\Phi / dA$\r\n\r\nFor directional dependence, radiance is:\r\n\r\n$L = d²\\Phi / (dA\\,d\\omega\\,\\cos\\theta)$\r\n\u003C/details>\r\n\r\n---\r\n\r\n## Basic math test\r\n\r\nInline math:  $E = dΦ / dA$\r\n\r\nBlock math:\r\n\r\n$$\r\nL = d²Φ / (dA · dω · cosθ)\r\n$$\r\n\r\nIf equations render correctly, KaTeX/MathJax is configured.\r\n\r\n---\r\n\r\n## Code block test\r\n```cpp\r\nstruct Ray {\r\n    vec3 origin;\r\n    vec3 direction;\r\n};\r\n\r\nvec3 trace(const Ray& ray) {\r\n    return vec3(0.0f);\r\n}\r\n```\r\n\u003Cimg\r\n    src={radiometryDiagram.src}\r\n    alt=\"Radiometry diagram\"\r\n    loading=\"lazy\"\r\n    class=\"img-inline\"\r\n    style={{ '--img-inline-width': '220px' }}\r\n/>\r\n\r\nwhat??","src/content/series/rendering/lecture-01/lecture.mdx","de0eb95299095fca",true]