---
import { getCollection } from 'astro:content';
import SiteLayout from '../components/SiteLayout.astro';
import { withBase, toSeriesSlug, toDerivationSlug } from '../utils/path';
import { SITE_CONFIG, UI_TEXT } from '../config/site';

const seriesEntries = (await getCollection('series')).sort(
  (a, b) => a.data.order - b.data.order
);

const derivationEntries = (await getCollection('derivations')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<SiteLayout title={SITE_CONFIG.title}>
  <main class="home-main">
    <section class="home-intro">
      <h1 class="home-title">{SITE_CONFIG.fullTitle}</h1>

      <p class="home-lead">
        {SITE_CONFIG.description}
      </p>

      <p class="home-sublead">
        {SITE_CONFIG.tagline}
      </p>
    </section>

    <section class="home-section">
      <h2 class="home-section-title">{UI_TEXT.sections.lectureSeries}</h2>

      <div class="series-list">
        {seriesEntries.map((entry) => {
          const slug = toSeriesSlug(entry.id);
          return (
            <a
              href={withBase(`series/${slug}`)}
              class="series-card"
            >
              <div class="series-card-title">{entry.data.title}</div>

              {entry.data.description && (
                <div class="series-card-summary">
                  {entry.data.description}
                </div>
              )}
            </a>
          );
        })}
      </div>
    </section>

    {derivationEntries.length > 0 && (
      <section class="home-section">
        <h2 class="home-section-title">Derivation Archive</h2>

        <div class="series-list">
          <a
            href={withBase('derivations')}
            class="series-card"
          >
            <div class="series-card-title">Mathematical Derivations</div>
            <div class="series-card-summary">
              Complete derivations ({derivationEntries.length} available) referenced throughout the lecture series.
            </div>
          </a>
        </div>
      </section>
    )}
  </main>
</SiteLayout>
