---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../../components/SiteLayout.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import { withBase, parseMetaPath, createSeriesMap } from '../../../utils/path';
import { SITE_CONFIG } from '../../../config/site';
import type { MetaEntry, SeriesEntry } from '../../../types/content';

export async function getStaticPaths() {
  const seriesEntries = await getCollection('series');
  const metaEntries = await getCollection('meta');
  const seriesBySlug = createSeriesMap(seriesEntries);

  return metaEntries.map((metaEntry) => {
    const { seriesSlug, fullSlug: slug } = parseMetaPath(metaEntry.id);

    return {
      params: { series: seriesSlug, slug },
      props: {
        metaEntry,
        seriesEntry: seriesBySlug.get(seriesSlug) ?? null,
        seriesSlug
      }
    };
  });
}

const { metaEntry, seriesEntry, seriesSlug } = Astro.props as {
  metaEntry: MetaEntry;
  seriesEntry: SeriesEntry | null;
  seriesSlug: string;
};

const { Content } = await render(metaEntry);
const { folderName: sectionName } = parseMetaPath(metaEntry.id);
---

<SiteLayout 
  title={`${metaEntry.data.title} | ${SITE_CONFIG.title}`} 
  isContentPage={true}
  seriesTitle={seriesEntry?.data.title}
>
  <main>
    <h1>{metaEntry.data.title}</h1>

    <div class="meta">
      <p class="meta-label">Page metadata</p>
      <dl class="meta-grid">
        {metaEntry.data.summary ? (
          <div class="meta-row meta-row-summary">
            <dt>Summary</dt>
            <dd>{metaEntry.data.summary}</dd>
          </div>
        ) : null}
        <div class="meta-row">
          <dt>Series</dt>
          <dd>{seriesEntry?.data.title ?? seriesSlug}</dd>
        </div>
        <div class="meta-row">
          <dt>Section</dt>
          <dd>{sectionName}</dd>
        </div>
      </dl>
    </div>

    <TableOfContents contentSelector=".meta-content" />
    
    <div class="meta-content">
      <Content />
    </div>

    <p class="page-return-link">
      <span class="return-link-icon" aria-hidden="true">↗</span>
      <a class="return-link" href={withBase(`series/${seriesSlug}`)}>Return to {seriesEntry?.data.title ?? 'series'}</a>
    </p>
  </main>
</SiteLayout>

<style>
  .meta-content {
    margin-top: 2rem;
  }
</style>
