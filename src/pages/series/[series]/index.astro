---
import { getCollection, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../../components/SiteLayout.astro';
import { withBase, toSeriesSlug, parseMetaPath } from '../../../utils/path';
import { SITE_CONFIG, UI_TEXT, NAVIGATION } from '../../../config/site';
import type { SeriesEntry, LectureEntry, MetaEntry } from '../../../types/content';

export async function getStaticPaths() {
  const seriesEntries = await getCollection('series');
  const lectureEntries = await getCollection('lectures');
  const metaEntries = await getCollection('meta');

  return seriesEntries.map((seriesEntry) => {
    const seriesSlug = toSeriesSlug(seriesEntry.id);
    const lectures = lectureEntries
      .filter((lectureEntry) => toSeriesSlug(lectureEntry.id) === seriesSlug)
      .sort((a, b) => a.data.lectureNumber - b.data.lectureNumber);
    
    const metaPages = metaEntries
      .filter((metaEntry) => toSeriesSlug(metaEntry.id) === seriesSlug)
      .sort((a, b) => a.data.order - b.data.order);

    return {
      params: { series: seriesSlug },
      props: {
        seriesEntry,
        lectures,
        metaPages
      }
    };
  });
}

const { seriesEntry, lectures, metaPages } = Astro.props as {
  seriesEntry: SeriesEntry;
  lectures: LectureEntry[];
  metaPages: MetaEntry[];
};

const seriesSlug = Astro.params.series ?? '';
---

<SiteLayout title={`${seriesEntry.data.title} | ${SITE_CONFIG.title}`}>
  <main class="home-main">
    <section class="home-intro">
      <h1 class="home-title">{seriesEntry.data.title}</h1>
      <p class="home-sublead">{seriesEntry.data.description}</p>
    </section>

    {metaPages.length > 0 && (
      <section>
        <h2 class="home-section-title">{UI_TEXT.sections.courseMaterials}</h2>
        
        <div class="meta-list">
          {metaPages.map((meta) => {
            const { fullSlug: metaSlug } = parseMetaPath(meta.id);
            
            return (
              <a href={withBase(`series/${seriesSlug}/${metaSlug}`)} class="meta-item">
                <div class="meta-item-title">{meta.data.title}</div>
                {meta.data.summary && (
                  <div class="meta-item-summary">{meta.data.summary}</div>
                )}
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section>
      <h2 class="home-section-title">{UI_TEXT.sections.lectures}</h2>

      <div class="series-list">
        {lectures.map((lecture) => {
          const lectureSlug = lecture.id.split('/')[1];
          return (
            <a href={withBase(`series/${seriesSlug}/${lectureSlug}`)} class="series-card">
              <div class="series-card-title">{lecture.data.lectureNumber}. {lecture.data.title}</div>
              {lecture.data.summary ? (
                <div class="series-card-summary">{lecture.data.summary}</div>
              ) : null}
            </a>
          );
        })}
      </div>
    </section>

    <p class="page-return-link">
      <span class="return-link-icon" aria-hidden="true">↗</span>
      <a class="return-link" href={withBase('')}>{NAVIGATION.returnHome}</a>
    </p>
  </main>
</SiteLayout>