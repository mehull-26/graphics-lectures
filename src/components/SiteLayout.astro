---
import '../styles/index.css';
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CustomCursor from './CustomCursor.astro';
import { normalizePath } from '../utils/path';
import { SITE_CONFIG } from '../config/site';

interface Props {
  title: string;
  description?: string;
  isContentPage?: boolean;
  seriesTitle?: string;
}

const { title, description = SITE_CONFIG.description, isContentPage = false, seriesTitle } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const rawPath = Astro.url.pathname;
const normalizedPath = normalizePath(rawPath, basePath);

// Extract page title for footer (remove site name suffix)
const pageTitle = title.includes('|') ? title.split('|')[0].trim() : null;
const currentUrl = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-content-page={isContentPage ? 'true' : 'false'}>
  <BaseHead title={title} description={description} />
  <body>
    <CustomCursor />
    <div class="site-shell">
      <Header currentPath={normalizedPath} />
      <slot />
      <Footer pageTitle={pageTitle} pageUrl={currentUrl} seriesTitle={seriesTitle} />
    </div>

    <script>
      import { setupThemeSystem } from '../lib/theme-manager';
      
      // Setup theme toggles
      setupThemeSystem();
    </script>
  </body>
</html>