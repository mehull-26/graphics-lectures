---
import { withBase } from '../utils/path';
import { SITE_CONFIG, ICON_PATHS, NAVIGATION, UI_TEXT } from '../config/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isSeriesActive = currentPath === '/series' || currentPath.startsWith('/series/');

// Extract series slug from path if we're in a series context
const seriesMatch = currentPath.match(/^\/series\/([^\/]+)/);
const currentSeriesSlug = seriesMatch ? seriesMatch[1] : null;
const seriesLink = currentSeriesSlug ? `series/${currentSeriesSlug}` : 'series';
---

<header class="site-header">
  <a class="site-brand" href={withBase('')}>{SITE_CONFIG.author}</a>
  <nav class="site-nav" aria-label={UI_TEXT.ariaLabels.primaryNav}>
    <a 
      class:list={{ 'site-nav-link': true, active: isSeriesActive }} 
      href={withBase(seriesLink)}
    >
      {NAVIGATION.items[0].label}
    </a>
    <button
      class="font-scale-toggle"
      id="font-scale-toggle"
      type="button"
      aria-label="Cycle font size"
    >
      <span class="font-scale-icon" aria-hidden="true">A</span>
    </button>
    <button 
      class="palette-toggle" 
      id="palette-toggle" 
      type="button" 
      aria-label={UI_TEXT.ariaLabels.paletteToggle}
    >
      <img 
        class="palette-icon" 
        src={withBase(ICON_PATHS.palette)} 
        alt="" 
        width="20" 
        height="20" 
        aria-hidden="true" 
      />
    </button>
    <button 
      class="theme-toggle" 
      id="theme-toggle" 
      type="button" 
      aria-label={UI_TEXT.ariaLabels.themeToggle}
    >
      <img 
        class="mode-icon" 
        src={withBase(ICON_PATHS.darkMode)} 
        alt="" 
        width="20" 
        height="20" 
        aria-hidden="true" 
      />
    </button>
  </nav>
</header>
