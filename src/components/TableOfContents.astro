---
interface Props {
  contentSelector?: string;
}

const { contentSelector = 'article' } = Astro.props;
---

<aside class="toc-shell is-hidden" data-toc data-content-selector={contentSelector} aria-label="Table of contents">
  <div class="toc-title">On this page</div>
  <nav class="toc-nav" data-toc-nav></nav>
  <div class="toc-controls" data-toc-controls>
    <button class="toc-control" type="button" data-toc-expand>Expand all</button>
    <button class="toc-control" type="button" data-toc-top>Back to top</button>
    <button class="toc-control" type="button" data-toc-bottom>Go to bottom</button>
  </div>
</aside>

<script is:inline>
  (() => {
    const slugify = (value) => value
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-');

    const initOne = (toc) => {
      if (!toc || toc.dataset.boundToc === 'true') return true;

      const selector = toc.getAttribute('data-content-selector') || 'article';
      const content = document.querySelector(selector);
      const nav = toc.querySelector('[data-toc-nav]');

      if (!content || !nav) {
        return false;
      }

      const headingElementsAll = [...content.querySelectorAll('h1, h2, h3, h4')]
        .filter((heading) => heading.textContent && heading.textContent.trim().length > 0);

      if (headingElementsAll.length < 1) {
        toc.classList.add('is-hidden');
        toc.dataset.boundToc = 'true';
        return true;
      }

      const levelsForOrder = headingElementsAll
        .map((heading) => Number(heading.tagName[1]));
      const uniqueSortedLevels = [...new Set(levelsForOrder)].sort((a, b) => a - b);
      const allowedLevels = new Set(uniqueSortedLevels.slice(0, 2));

      if (allowedLevels.size === 0) {
        const fallbackLevels = [...new Set(headingElementsAll.map((heading) => Number(heading.tagName[1])))]
          .sort((a, b) => a - b)
          .slice(0, 2);
        fallbackLevels.forEach((level) => allowedLevels.add(level));
      }

      const orderedAllowedLevels = [...allowedLevels].sort((a, b) => a - b);
      const depthByLevel = new Map(orderedAllowedLevels.map((level, index) => [level, index]));

      const headingElements = headingElementsAll.filter((heading) =>
        allowedLevels.has(Number(heading.tagName[1]))
      );

      if (headingElements.length < 1) {
        toc.classList.add('is-hidden');
        toc.dataset.boundToc = 'true';
        return true;
      }

      const usedIds = new Set();
      headingElements.forEach((heading) => {
        const existingId = heading.getAttribute('id');
        if (existingId) {
          usedIds.add(existingId);
          return;
        }

        const base = slugify(heading.textContent || 'section') || 'section';
        let id = base;
        let index = 2;
        while (usedIds.has(id)) {
          id = `${base}-${index}`;
          index += 1;
        }
        usedIds.add(id);
        heading.setAttribute('id', id);
      });

      const nodes = [];
      const stack = [{ level: 0, children: nodes, parentId: null }];

      headingElements.forEach((heading) => {
        const level = Number(heading.tagName[1]);
        const node = {
          id: heading.id,
          level,
          text: (heading.textContent || '').trim(),
          children: [],
          element: heading,
          parentId: null
        };

        while (stack.length > 1 && stack[stack.length - 1].level >= level) {
          stack.pop();
        }

        const parent = stack[stack.length - 1];
        node.parentId = parent.parentId;
        parent.children.push(node);
        stack.push({ level, children: node.children, parentId: node.id });
      });

      const renderNodeList = (list) => {
        const ul = document.createElement('ul');
        ul.className = 'toc-list';

        list.forEach((node) => {
          const li = document.createElement('li');
          li.className = `toc-item toc-level-${node.level}`;
          li.dataset.tocId = node.id;
          li.dataset.tocLevel = String(node.level);

          const depth = depthByLevel.get(node.level) ?? 0;
          li.classList.add(`toc-depth-${depth}`);

          const link = document.createElement('a');
          link.href = `#${node.id}`;
          link.textContent = node.text;
          link.className = 'toc-link';
          li.appendChild(link);

          if (node.children.length > 0) {
            li.classList.add('has-children');
            li.appendChild(renderNodeList(node.children));
          }

          ul.appendChild(li);
        });

        return ul;
      };

      nav.innerHTML = '';
      nav.appendChild(renderNodeList(nodes));

      const items = [...toc.querySelectorAll('.toc-item')];
      const byId = new Map(items.map((item) => [item.dataset.tocId, item]));
      const controls = toc.querySelector('[data-toc-controls]');
      const expandButton = toc.querySelector('[data-toc-expand]');
      const topButton = toc.querySelector('[data-toc-top]');
      const bottomButton = toc.querySelector('[data-toc-bottom]');
      let expandAll = false;

      const openPathFor = (activeId) => {
        items.forEach((item) => item.classList.remove('is-active', 'in-path'));
        if (activeId) {
          const activeItem = byId.get(activeId);
          if (activeItem) {
            activeItem.classList.add('is-active');

            let current = activeItem;
            while (current) {
              current.classList.add('in-path');
              const parent = current.parentElement?.closest('.toc-item');
              current = parent;
            }
          }
        }

        items.forEach((item) => {
          if (!item.classList.contains('has-children')) return;
          const keepOpenByPath = item.classList.contains('in-path');
          const shouldCollapse = !expandAll && !keepOpenByPath;
          item.classList.toggle('is-collapsed', shouldCollapse);
        });
      };

      const updateVisibility = () => {
        const main = document.querySelector('main');
        if (!main) return;

        const mainRect = main.getBoundingClientRect();
        const leftSpace = mainRect.left;
        const baseWidth = 286;
        const minWidth = 194;
        const gutter = 16;
        const availableWidth = leftSpace - gutter - 8;
        const targetWidth = Math.min(baseWidth, availableWidth);
        const enoughRoom = window.innerWidth >= 980 && targetWidth >= minWidth;

        toc.classList.toggle('is-hidden', !enoughRoom);
        if (enoughRoom) {
          const desiredLeft = leftSpace - targetWidth - gutter;
          toc.style.setProperty('--toc-current-width', `${targetWidth}px`);
          toc.style.left = `${desiredLeft}px`;
          toc.classList.toggle('is-tight', targetWidth < 244);
          toc.classList.toggle('is-compact', targetWidth < 220);
        } else {
          toc.style.removeProperty('--toc-current-width');
          toc.style.left = '';
          toc.classList.remove('is-tight', 'is-compact');
        }
      };

      const getActiveHeadingId = () => {
        const header = document.querySelector('.site-header');
        const topOffset = (header ? header.getBoundingClientRect().height : 0) + 18;
        const triggerLine = topOffset + Math.max(0, (window.innerHeight - topOffset) * 0.25);

        let current = headingElements[0];
        for (const heading of headingElements) {
          if (heading.getBoundingClientRect().top <= triggerLine) {
            current = heading;
          } else {
            break;
          }
        }

        return current?.id ?? null;
      };

      let rafId = 0;
      const onScroll = () => {
        if (rafId) return;
        rafId = window.requestAnimationFrame(() => {
          const activeId = getActiveHeadingId();
          openPathFor(activeId);
          rafId = 0;
        });
      };

      const onResize = () => {
        updateVisibility();
        onScroll();
      };

      if (controls && expandButton && topButton && bottomButton) {
        expandButton.addEventListener('click', () => {
          expandAll = !expandAll;
          expandButton.textContent = expandAll ? 'Collapse all' : 'Expand all';
          openPathFor(getActiveHeadingId());
        });

        topButton.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        bottomButton.addEventListener('click', () => {
          window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
        });
      }

      updateVisibility();
      onScroll();

      window.addEventListener('resize', onResize, { passive: true });
      window.addEventListener('scroll', onScroll, { passive: true });

      toc.dataset.boundToc = 'true';
      return true;
    };

    const initAll = () => {
      const tocs = [...document.querySelectorAll('[data-toc]')];
      if (tocs.length === 0) return true;

      let allReady = true;
      tocs.forEach((toc) => {
        const ready = initOne(toc);
        allReady = allReady && ready;
      });
      return allReady;
    };

    const bootstrap = () => {
      let attempts = 0;
      const run = () => {
        const ready = initAll();
        if (!ready && attempts < 40) {
          attempts += 1;
          window.requestAnimationFrame(run);
        }
      };
      run();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
    } else {
      bootstrap();
    }

    document.addEventListener('astro:page-load', bootstrap);
  })();
</script>
