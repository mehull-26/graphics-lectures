---
import { CONTENT_CONFIG, UI_TEXT } from '../config/site';

interface Props {
  contentSelector?: string;
}

const { contentSelector = CONTENT_CONFIG.defaultContentSelector } = Astro.props;
---

<aside class="toc-shell is-hidden" data-toc data-content-selector={contentSelector} aria-label={UI_TEXT.ariaLabels.toc}>
  <div class="toc-title">{UI_TEXT.tocTitle}</div>
  <nav class="toc-nav" data-toc-nav></nav>
  <div class="toc-controls" data-toc-controls>
    <button class="toc-control" type="button" data-toc-expand>{UI_TEXT.tocControls.expand}</button>
    <button class="toc-control" type="button" data-toc-top>{UI_TEXT.tocControls.top}</button>
    <button class="toc-control" type="button" data-toc-bottom>{UI_TEXT.tocControls.bottom}</button>
  </div>
</aside>

<script>
  import { setupToc } from '../lib/toc';
  
  // Initialize all table of contents instances
  setupToc();
</script>
